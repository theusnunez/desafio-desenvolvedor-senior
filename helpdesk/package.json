{
  "name": "helpdesk",
  "adonis-version": "4.1.0",
  "description": "A sample helpdesk app",
  "main": "index.js",
  "scripts": {
    "start": "pm2 startOrReload ecosystem.config.js && pm2 logs all",
    "start:prod": "node server.js",
    "test": "node ace test",
    "dev": "nodemon --watch app --watch bootstrap --watch config --watch .env -x node --inspect server.js",
    "lint": "eslint \"**/*.js\" --ignore-path .gitignore",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "setup": "npm install"
  },
  "author": "Felipe Secato",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "@adonisjs/ace": "^5.0.1",
    "@adonisjs/auth": "^3.0.5",
    "@adonisjs/bodyparser": "^2.0.3",
    "@adonisjs/drive": "^1.0.2",
    "@adonisjs/fold": "^4.0.7",
    "@adonisjs/framework": "^5.0.5",
    "@adonisjs/ignitor": "*",
    "@adonisjs/lucid": "^5.0.3",
    "@adonisjs/mail": "^3.0.6",
    "@adonisjs/session": "^1.0.25",
    "@adonisjs/shield": "^1.0.6",
    "@adonisjs/validator": "^5.0.3",
    "group": "^1.0.2",
    "knex": "^3.1.0",
    "mongodb": "^6.6.2",
    "mysql": "^2.18.1",
    "pg": "^7.18.2",
    "pm2": "^3.1.3",
    "socket.io": "^4.7.5"
  },
  "autoload": {
    "App": "./app"
  },
  "devDependencies": {
    "nodemon": "*",
    "sqlite3": "*",
    "eslint": "^8.45.0",
    "prettier": "^2.8.8",
    "husky": "^8.0.0",
    "lint-staged": "^14.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.js": ["eslint --fix", "prettier --write", "git add"]
  }
}
